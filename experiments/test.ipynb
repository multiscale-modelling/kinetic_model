   "source": [
    "input=\"files/plots/models.pdf\"\n",
    "out=\"files/plots/models.svg\"\n",
    "\n",
    "import fitz  # PyMuPDF\n",
    "\n",
    "doc = fitz.open(input)\n",
    "page = doc[0]           # first page\n",
    "svg = page.get_svg_image()   # returns SVG as string\n",
    "\n",
    "with open(out, \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(svg)\n",
    "\n"
   ]
  }

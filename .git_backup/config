[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://gitlab.kit.edu/aleksandr.avdoshin/kinetic_model.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "chemisorption"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/chemisorption
[branch "new_profile"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/new_profile
